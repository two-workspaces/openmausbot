# The edge in front of OpenMausBot, as upstream's deploy/Caddyfile but on Railway: Railway's proxy
# terminates TLS, so Caddy serves plain http on $PORT. Login is upstream's own (email sign-in or a
# pairing code); Caddy adds no password.
{
	admin off
	auto_https off
	servers {
		# Railway's proxy connects from 100.64.0.0/10 and appends the client to X-Forwarded-For.
		# Trusting only that range, right to left, makes {client_ip} the address Railway saw, so a
		# client can't pick its own address for the pairing lockout.
		trusted_proxies static 100.64.0.0/10
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# Not 8080: OpenMausBot polls 127.0.0.1:8080/v1 for a local oMLX model server
# (server/drivers/local-inject.ts), and would find Caddy there.
:{$PORT:8790} {
	encode zstd gzip

	# Webhook ingress has its own per-hook secrets and must be reachable by third parties.
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8799 {
			# The server reads the last X-Forwarded-For hop as the client; send only that.
			header_up X-Forwarded-For {client_ip}
			# SSE: stream events as they arrive
			flush_interval -1
		}
	}
}
